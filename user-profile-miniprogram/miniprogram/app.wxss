page {
  min-height: 100vh;
  color: #101828;
  background: linear-gradient(180deg, #fafdff 0%, #f5f8fc 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  box-sizing: border-box;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 56rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  border: 1rpx solid #e4eaf2;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(16, 24, 40, 0.06);
}

.primary-btn {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #12b8c8, #21c3d3);
  font-size: 32rpx;
  font-weight: 700;
}

.secondary-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d0d9e8;
  border-radius: 24rpx;
  color: #075464;
  background: #ffffff;
  font-size: 30rpx;
  font-weight: 650;
}
