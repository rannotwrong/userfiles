.legal-page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f5f8fc;
}

.legal-card {
  padding: 40rpx 34rpx;
  border: 1rpx solid #e3ebf5;
  border-radius: 28rpx;
  background: #ffffff;
}

.legal-title,
.legal-date,
.legal-heading,
.legal-text {
  display: block;
}

.legal-title {
  color: #101828;
  font-size: 44rpx;
  font-weight: 850;
}

.legal-date {
  margin-top: 10rpx;
  color: #98a2b3;
  font-size: 24rpx;
}

.legal-heading {
  margin-top: 34rpx;
  color: #344054;
  font-size: 30rpx;
  font-weight: 800;
}

.legal-text {
  margin-top: 12rpx;
  color: #667085;
  font-size: 28rpx;
  line-height: 1.8;
}
