.login-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.brand-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx;
  text-align: center;
}

.logo {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.eyebrow {
  color: #0891a5;
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 0.12em;
}

.title {
  margin-top: 8rpx;
  color: #101828;
  font-size: 56rpx;
  font-weight: 850;
}

.desc {
  margin-top: 18rpx;
  color: #667085;
  font-size: 28rpx;
  line-height: 1.7;
}

.tip {
  color: #98a2b3;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.agreement-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
}

.agreement-check {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.agreement-check checkbox {
  transform: scale(0.78);
}

.text-link {
  min-height: auto;
  margin: 0;
  padding: 0;
  color: #087f8f;
  background: transparent;
  font-size: 24rpx;
  line-height: 1.6;
}

.text-link::after {
  border: 0;
}
