.home-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.eyebrow {
  display: block;
  color: #0891a5;
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 0.12em;
}

.page-title {
  display: block;
  margin-top: 8rpx;
  color: #101828;
  font-size: 52rpx;
  font-weight: 850;
}

.plain-btn {
  min-width: 112rpx;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #075464;
  background: #e9fbfe;
  font-size: 26rpx;
  font-weight: 700;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.stat-card {
  min-height: 132rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid #e3ebf5;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12rpx 30rpx rgba(16, 24, 40, 0.04);
}

.stat-label {
  display: block;
  color: #667085;
  font-size: 22rpx;
  font-weight: 700;
}

.stat-value {
  display: block;
  margin-top: 12rpx;
  color: #101828;
  font-size: 38rpx;
  font-weight: 850;
}

.section-title {
  display: block;
  margin-top: 8rpx;
  color: #101828;
  font-size: 40rpx;
  font-weight: 850;
}

.capture-card,
.profile-card {
  padding: 32rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 26rpx;
}

.pill {
  flex: 0 0 auto;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #075464;
  background: #e9fbfe;
  font-size: 24rpx;
  font-weight: 750;
}

.upload-zone {
  width: 100%;
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 28rpx;
  border: 2rpx dashed #c7d7eb;
  border-radius: 28rpx;
  color: #101828;
  background: #f8fbff;
}

.upload-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #12b8c8;
  background: #e9fbfe;
  font-size: 42rpx;
  line-height: 1;
}

.upload-title {
  font-size: 30rpx;
  font-weight: 800;
}

.upload-desc {
  max-width: 560rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
  word-break: break-all;
}

.capture-grid,
.form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.capture-grid {
  margin-bottom: 24rpx;
}

.wide-field {
  grid-column: span 2;
}

.field {
  min-width: 0;
  margin-bottom: 20rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #667085;
  font-size: 24rpx;
  font-weight: 750;
}

.field input,
.picker-field {
  width: 100%;
  min-height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dfe7f2;
  border-radius: 22rpx;
  color: #101828;
  background: #ffffff;
  font-size: 30rpx;
}

.picker-field {
  display: flex;
  align-items: center;
}

.text-area {
  width: 100%;
  min-height: 188rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #dfe7f2;
  border-radius: 22rpx;
  color: #101828;
  background: #ffffff;
  font-size: 30rpx;
  line-height: 1.6;
}

.text-area.small {
  min-height: 132rpx;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.action-btn {
  width: 100%;
}

.mini-primary {
  min-width: 120rpx;
  min-height: 66rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #12b8c8, #21c3d3);
  font-size: 26rpx;
  font-weight: 800;
}

.toolbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 210rpx;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.search-box {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 92rpx;
  gap: 12rpx;
}

.search-box input,
.tier-picker {
  min-height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dfe7f2;
  border-radius: 22rpx;
  color: #101828;
  background: #ffffff;
  font-size: 28rpx;
}

.tier-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #075464;
  font-weight: 750;
}

.search-btn {
  min-height: 76rpx;
  border-radius: 22rpx;
  color: #075464;
  background: #e9fbfe;
  font-size: 26rpx;
  font-weight: 800;
}

.empty-state {
  padding: 56rpx 24rpx;
  border: 1rpx dashed #c7d7eb;
  border-radius: 24rpx;
  color: #667085;
  background: #f8fbff;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.profile-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.profile-item {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e3ebf5;
  border-radius: 26rpx;
  background: #fbfdff;
}

.tier-badge {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.tier-S {
  background: #f97316;
}

.tier-A {
  background: #12b8c8;
}

.tier-B {
  background: #6d8cff;
}

.tier-C {
  background: #98a2b3;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.profile-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.profile-name {
  min-width: 0;
  color: #101828;
  font-size: 32rpx;
  font-weight: 850;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-money {
  flex: 0 0 auto;
  color: #075464;
  font-size: 28rpx;
  font-weight: 850;
}

.profile-meta {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #075464;
  background: #e9fbfe;
  font-size: 22rpx;
  font-weight: 700;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 32rpx;
  background: rgba(16, 24, 40, 0.28);
}

.modal-card {
  width: 100%;
  max-height: 88vh;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  overflow-y: auto;
  box-shadow: 0 24rpx 72rpx rgba(16, 24, 40, 0.18);
}

.check-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin: 2rpx 0 20rpx;
}

.check-chip {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid #dfe7f2;
  border-radius: 22rpx;
  color: #475467;
  background: #fbfdff;
  font-size: 24rpx;
  font-weight: 700;
}

.check-chip switch {
  transform: scale(0.72);
  transform-origin: left center;
  margin-right: -14rpx;
}

.save-profile-btn {
  width: 100%;
  margin-top: 8rpx;
}

@media (max-width: 390px) {
  .page-title {
    font-size: 46rpx;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stat-card {
    min-height: 112rpx;
  }

  .capture-card,
  .profile-card,
  .modal-card {
    padding: 26rpx;
  }

  .capture-grid,
  .form-row,
  .action-row {
    grid-template-columns: 1fr;
  }

  .wide-field {
    grid-column: auto;
  }

  .toolbar {
    grid-template-columns: 1fr;
  }

  .check-grid {
    grid-template-columns: 1fr;
  }

  .profile-row {
    flex-direction: column;
    gap: 6rpx;
  }
}
