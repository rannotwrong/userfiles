PORT=3000

WECHAT_APP_ID=请填入微信小程序 AppID
WECHAT_APP_SECRET=请填入微信小程序 AppSecret

SUPABASE_URL=https://你的项目编号.supabase.co
SUPABASE_SERVICE_ROLE_KEY=请填入 Supabase service_role key，仅服务端使用

SESSION_JWT_SECRET=请替换为至少 32 位的随机字符串
SESSION_TTL_DAYS=30

# 火山方舟 / 豆包 API Key。只放在服务端或云函数环境变量里，不要写入小程序端。
ARK_API_KEY=

# 支持图片输入的豆包视觉模型，按火山方舟控制台实际开通的模型 ID 填写。
DOUBAO_VISION_MODEL=doubao-seed-1-8-251228
